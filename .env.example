# ===== AQUASTATS ENVIRONMENT VARIABLES =====

# Environment
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://aquastats:dev-password-change-in-prod@localhost:5432/aquastats
DATABASE_SSLMODE=disable

# Session & Auth
SESSION_SECRET=your-super-secret-session-key-here-min-32-chars-123456
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# Google OAuth (for testing signup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (via Mailpit in dev, Resend in prod)
MAIL_FROM=noreply@aquastats.net
CONTACT_EMAIL=contact@aquastats.net
SECURITY_EMAIL=security@aquastats.net
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Stripe Payment Processing
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# S3/Minio Storage
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Security
TRUST_PROXY=false
CORS_ORIGINS_EXTRA=

# Rate Limiting & Abuse Prevention
MAX_REQUEST_BODY_BYTES=1048576
DB_STATEMENT_TIMEOUT_MS=30000

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Feature Flags
COACH_SIGNUP_ENABLED=false
DATABASE_ENABLE_RLS=true

# API Configuration
RECENT_AUTH_SECONDS=300
EDGE_AUTH_TOKEN=
OUTBOX_BATCH_SIZE=20
