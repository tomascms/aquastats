# Copia para apps/api/.env. Nunca commits este ficheiro com valores reais.
# Schema: db/schema.sql. Local: uvicorn app.main:app --reload --port 8000 (a partir de apps/api, com PYTHONPATH=src)

APP_ENV=development
APP_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:8000

# PostgreSQL em rede (Neon, Railway, VPS, etc.). Depois corre db/schema.sql nesse host.
# DATABASE_SSLMODE=auto  (disable em localhost, require no resto)
DATABASE_URL=
# Fluxos de autenticação (role aquastats_auth em produção). Vazio = o mesmo DATABASE_URL (local).
AUTH_DATABASE_URL=
DATABASE_SSLMODE=auto

# >= 32 caracteres aleatórios. Gera com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Google OAuth — cria no TEU projecto GCP (conta Gmail dedicada ao Aquastats).
# Nunca uses projectos de trabalho ou contas pessoais de outras apps.
# Authorized redirect URIs:
#   https://aquastats.net/api/v1/auth/google/callback
#   https://www.aquastats.net/api/v1/auth/google/callback
#   http://127.0.0.1:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Produção: APP_ENV=production TRUST_PROXY=true
# Produção: DATABASE_ENABLE_RLS=true, DATABASE_URL com aquastats_api e AUTH_DATABASE_URL com aquastats_auth.
# Local: base local ou de staging (o arranque recusa a base de produção fora de APP_ENV=production).
# Em produção o CORS é só https://aquastats.net e https://www.aquastats.net. localhost fica de fora.
# CORS_ORIGINS_EXTRA=https://www.aquastats.net
TRUST_PROXY=false
DATABASE_ENABLE_RLS=false

# Opcional, mas recomendado: segredo partilhado entre Cloudflare Worker e Cloud Run.
# EDGE_AUTH_TOKEN=

# Registo de treinador (requer pagamentos). false até Stripe estar activo.
COACH_SIGNUP_ENABLED=false

# Email de entrada: Cloudflare Email Routing (contact@, confirmation@, security@).
# MAIL_FROM=confirmation@aquastats.net
# CONTACT_EMAIL=contact@aquastats.net
# SECURITY_EMAIL=security@aquastats.net
# SMTP de saída (Resend ou outro) só quando quiseres enviar confirmações.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
