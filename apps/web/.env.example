# URL da API (local ou o serviço em produção).
API_URL=http://127.0.0.1:8000

# Opcional em local; em produção deve ser um secret do Worker, nunca um var público.
# EDGE_AUTH_TOKEN=

# URL pública do site. Em produção: https://aquastats.net
APP_URL=http://127.0.0.1:3000

# Emails via Cloudflare Email Routing. Em produção:
# MAIL_FROM=confirmation@aquastats.net
# CONTACT_EMAIL=contact@aquastats.net
# SECURITY_EMAIL=security@aquastats.net
